#!/usr/bin/env bash
# LCW setup — register skill with a project (multi-host)
set -e

LCW_DIR="$(cd "$(dirname "$0")" && pwd -P)"
SKILL_SRC="$LCW_DIR/skills/lcw"

# ─── Parse flags ──────────────────────────────────────────────

PROJECT=""
HOSTS=""
while [ $# -gt 0 ]; do
  case "$1" in
    --host)   HOSTS="$HOSTS $2"; shift 2 ;;
    --host=*) HOSTS="$HOSTS ${1#--host=}"; shift ;;
    -h|--help)
      cat <<'EOF'
Usage: ~/.lcw/setup [<project>] [--host <host>...]

Install LCW skill into a project by creating symlinks.
Only project-level installation is supported — no global install.

Arguments:
  <project>          Target project directory (default: current directory)

Options:
  --host <host>      Host tool: claude, codex, opencode, windsurf
                     (default: claude; repeatable)

Examples:
  ~/.lcw/setup                                # current dir, Claude Code
  ~/.lcw/setup ~/work/my-wiki                 # specific project
  ~/.lcw/setup --host codex --host opencode   # multiple hosts
  ~/.lcw/setup ~/work/my-wiki --host codex    # both
EOF
      exit 0
      ;;
    *)
      if [ -z "$PROJECT" ]; then
        PROJECT="$1"
      fi
      shift
      ;;
  esac
done

[ -z "$PROJECT" ] && PROJECT="."
[ -z "$HOSTS" ] && HOSTS="claude"

# ─── Resolve project path ────────────────────────────────────

PROJECT="$(cd "$PROJECT" && pwd -P)"

# ─── Create symlinks ─────────────────────────────────────────

link_skill() {
  local dest="$1"
  mkdir -p "$dest"

  if [ -L "$dest/lcw" ]; then
    rm "$dest/lcw"
  elif [ -e "$dest/lcw" ]; then
    echo "  skip: $dest/lcw exists and is not a symlink" >&2
    return
  fi

  ln -s "$SKILL_SRC" "$dest/lcw"
  echo "  $dest/lcw -> $SKILL_SRC"
}

host_to_path() {
  case "$1" in
    claude)   echo ".claude/skills" ;;
    codex)    echo ".codex/skills" ;;
    opencode) echo ".opencode/skills" ;;
    windsurf) echo ".windsurf/skills" ;;
    *)        echo "" ;;
  esac
}

echo "Setting up LCW in $PROJECT"

for HOST in $HOSTS; do
  SKILL_DIR="$(host_to_path "$HOST")"
  if [ -z "$SKILL_DIR" ]; then
    echo "  unknown host: $HOST (expected: claude, codex, opencode, windsurf)" >&2
    continue
  fi
  link_skill "$PROJECT/$SKILL_DIR"
done

# ─── Install hooks (Claude Code only) ────────────────────────

install_hooks() {
  local settings="$PROJECT/.claude/settings.json"
  local hooks_dir="$LCW_DIR/hooks"

  # Only install if Claude is one of the target hosts
  echo "$HOSTS" | grep -q "claude" || return 0

  # Check if hooks scripts exist
  [ -f "$hooks_dir/lcw-log-check.sh" ] || return 0

  # Create settings.json if it doesn't exist
  if [ ! -f "$settings" ]; then
    mkdir -p "$PROJECT/.claude"
    echo '{}' > "$settings"
  fi

  # Check if hooks are already configured (avoid duplicates)
  if grep -q "lcw-log-check" "$settings" 2>/dev/null; then
    echo "  hooks: already configured"
    return 0
  fi

  # Add hooks using a simple approach — merge into existing settings
  local tmp=$(mktemp)
  if command -v python3 &>/dev/null; then
    python3 -c "
import json, sys
with open('$settings') as f:
    cfg = json.load(f)
cfg.setdefault('hooks', {}).setdefault('Stop', [])
cfg['hooks']['Stop'].append({'matcher': '', 'command': '$hooks_dir/lcw-log-check.sh'})
cfg['hooks']['Stop'].append({'matcher': '', 'command': '$hooks_dir/lcw-index-check.sh'})
with open('$tmp', 'w') as f:
    json.dump(cfg, f, indent=2)
" && mv "$tmp" "$settings" && echo "  hooks: installed (Stop: log-check, index-check)"
  else
    rm -f "$tmp"
    echo "  hooks: skipped (python3 not found for JSON merge)"
  fi
}

install_hooks

echo ""
echo "Run /lcw init in the project to create the wiki."
